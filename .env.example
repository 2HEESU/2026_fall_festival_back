DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin.localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://admin.localhost:5173

# 관리자 API를 admin 서브도메인으로 인식할 호스트 목록 (콤마 구분)
ADMIN_HOSTS=admin.localhost

# Production example:
# DATABASE_URL=postgresql://festival:password@localhost:5432/festival

# 관리자 API 토큰 (apps.admins 인증 확정 전까지 사용 추 후에 바꿈-수아)
ADMIN_API_TOKEN=local-admin-token

KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:5173/
KAKAO_CLIENT_SECRET=